{
  "name": "Build an Emoji — Emoticon & Kaomoji Puzzle Game",
  "short_name": "Build an Emoji",
  "description": "Interactive browser puzzle game where you drag and drop character pieces to assemble classic text emoticons and kaomoji like Smile :), Shrug ¯\\_(ツ)_/¯, and Table Flip (╯°□°）╯︵ ┻━┻.",
  "start_url": "/index.html",
